Table entries [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	title varchar(255) [ not null ]
	description text(65535)
	phase varchar(255) [ not null ]
	os varchar(255)
	notes text(65535)
}

Table blocks [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	entry_id integer [ not null ]
	parent_id integer
	position integer [ not null ]
	title varchar(255) [ not null ]

	indexes {
		(entry_id, id) [unique]
		(parent_id, position) [unique]
	}
	Note: 'Root positions are unique per entry where parent_id is NULL.'
}

Enum item_kind {
	text
	command
	image
	note
}

Table items [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	block_id integer [ not null ]
	position integer [ not null ]
	kind item_kind [ not null ]
	content text [ not null ]
	language varchar(255)

	indexes {
		(block_id, position) [unique]
	}
}

Table tags [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null, unique ]
}

Table entry_tag [headercolor: #175e7a] {
	entry_id integer [ not null ]
	tag_id integer [ not null ]
	indexes {
		(entry_id, tag_id) [pk]
	}
}

Table machines [headercolor: #175e7a] {
	id integer [ pk, increment, not null ]
	name varchar(255) [ not null, unique ]
	os varchar(255)
}

Table entry_machine [headercolor: #175e7a] {
	entry_id integer [ not null ]
	machine_id integer [ not null ]
	indexes {
		(entry_id, machine_id) [pk]
	}
}

Ref fk_entries_id_blocks {
	entries.id < blocks.entry_id [ delete: cascade ]
}

Ref fk_blocks_parent {
	blocks.(entry_id, id) < blocks.(entry_id, parent_id) [ delete: cascade ]
}

Ref fk_blocks_items {
	blocks.id < items.block_id [ delete: cascade ]
}

Ref fk_entries_id_entry_tags {
	entries.id < entry_tag.entry_id [ delete: no action, update: no action ]
}

Ref fk_tags_id_entry_tags {
	tags.id < entry_tag.tag_id [ delete: no action, update: no action ]
}

Ref fk_entries_id_entry_machine {
	entries.id < entry_machine.entry_id [ delete: no action, update: no action ]
}

Ref fk_machines_id_entry_machine {
	machines.id < entry_machine.machine_id [ delete: no action, update: no action ]
}
